#!/bin/bash
#
# uninstall-watchdog -- undo the watchdog_system install and return the
# deploy host to the legacy `_ngps`/`ngps-daemon.{service,timer}` boot path.
# Disaster-recovery/rollback tool -- not for routine use.
#
# Run as root or via sudo. Stops the new units before removing the unit files
# so systemd does not lose track of running processes.
#
set -e

WATCHDOG_DIR="${WATCHDOG_DIR:-/home/developer/Software/watchdog_system}"
RUN_DIR="${RUN_DIR:-/home/developer/Software/run}"

# Stop everything (commanded stop suppresses Restart=always)
sudo systemctl stop ngps-watchdog.service || true
sudo systemctl stop ngps.target           || true   # cascades via PartOf=

# Disable so nothing comes back on reboot
sudo systemctl disable ngps.target ngps-watchdog.service 2>/dev/null || true
sudo systemctl disable 'ngps@*.service'                  2>/dev/null || true

# Remove the unit files and any symlinks left behind
sudo rm -f  /etc/systemd/system/ngps@.service
sudo rm -f  /etc/systemd/system/ngps.target
sudo rm -f  /etc/systemd/system/ngps-watchdog.service
sudo rm -rf /etc/systemd/system/ngps@sequencerd.service.d
sudo rm -f  /etc/systemd/system/multi-user.target.wants/ngps.target
sudo rm -rf /etc/systemd/system/ngps.target.wants

# Remove the environment file and the polkit rule
sudo rm -f /etc/sysconfig/ngps
sudo rm -f /etc/polkit-1/rules.d/10-ngps.rules

# Remove any /usr/local/bin/ngps left behind by a prior install -- an older,
# unrelated install location that predates run/ngps/watchdog_system/bin/ngps
# entirely; kept as a defensive no-op cleanup, not something this project
# ever installs to.
sudo rm -f /usr/local/bin/ngps
hash -r

# Tell systemd everything is gone
sudo systemctl daemon-reload
sudo systemctl reset-failed

# Restore the legacy launcher scripts from watchdog_system/legacy/ -- kept
# permanently tracked there (never deleted) specifically so this step
# never depends on a separate `git checkout main`. -m 0755 matches the
# executable bit git already tracks for both.
sudo install -m 0755 "$WATCHDOG_DIR/legacy/_ngps" "$RUN_DIR/_ngps"
sudo install -m 0755 "$WATCHDOG_DIR/legacy/ngps"  "$RUN_DIR/ngps"

# Re-enable the old boot path (whichever main uses)
sudo systemctl enable --now ngps-daemon.timer   2>/dev/null || true
sudo systemctl enable --now ngps-daemon.service 2>/dev/null || true

cat <<'EOF'

Restore complete. Verify with:

    systemctl list-unit-files 'ngps*'        # ngps@.service / ngps.target / ngps-watchdog should NOT appear
    systemctl list-units --failed            # empty (or unrelated)
    ls /usr/local/bin/ngps                   # not found (unrelated legacy path, see above)
    ls -l run/ngps run/_ngps                 # restored from watchdog_system/legacy/, executable
    ls /etc/polkit-1/rules.d/ | grep ngps    # empty

EOF
