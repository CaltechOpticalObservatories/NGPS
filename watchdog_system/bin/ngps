#!/bin/bash
#
# ngps -- operator front-end to NGPS daemon processes via systemd.
#
#   ngps {start|stop|restart} {all|<daemon> [<daemon> ...]}
#   ngps status [<daemon> [<daemon> ...]]
#   ngps {enable|disable}
#   ngps list
#
# Requires the polkit rule (10-ngps.rules) so the invoking operator may
# manage ngps units without a password. This script itself is developer-
# only -- execute permission is restricted to user "developer" by
# install-watchdog; operators use `systemctl` directly (see readme.txt).
#

SYSTEMCTL=/usr/bin/systemctl

DAEMONS=(messaged acamd slicecamd calibd camerad flexured focusd thermald powerd slitd tcsd sequencerd)

usage() {
  echo "Usage: ngps {start|stop|restart} {all|<daemon> [<daemon> ...]}" >&2
  echo "       ngps status [<daemon> ...]" >&2
  echo "       ngps {enable|disable}" >&2
  echo "       ngps list" >&2
  echo "       daemons: ${DAEMONS[*]}" >&2
  exit 1
}

# Validate the given names and populate UNITS=() with ngps@<name>.service.
build_units() {
  UNITS=()
  local n d ok
  for n in "$@"; do
    ok=0
    for d in "${DAEMONS[@]}"; do
      [ "$n" = "$d" ] && ok=1 && break
    done
    if [ $ok -eq 0 ]; then
      echo "ERROR: unknown daemon: $n" >&2
      echo "       valid: ${DAEMONS[*]}" >&2
      exit 1
    fi
    UNITS+=("ngps@$n.service")
  done
}

[ $# -ge 1 ] || usage
cmd="$1"; shift

case "$cmd" in
  start|stop|restart)
    [ $# -ge 1 ] || usage
    if [ "$1" = "all" ]; then
      [ $# -eq 1 ] || usage
      exec "$SYSTEMCTL" "$cmd" ngps.target 'ngps@*'
    else
      build_units "$@"
      exec "$SYSTEMCTL" "$cmd" "${UNITS[@]}"
    fi
    ;;
  status)
    if [ $# -eq 0 ]; then
      exec "$SYSTEMCTL" --no-pager status ngps.target 'ngps@*'
    else
      build_units "$@"
      exec "$SYSTEMCTL" --no-pager status "${UNITS[@]}"
    fi
    ;;
  enable|disable)
    if [ $# -ne 0 ]; then
      echo "ERROR: $cmd takes no arguments -- it always acts on ngps.target" >&2
      echo "       only. ngps.target's Wants= already pulls in every" >&2
      echo "       instance regardless of that instance's own enable state," >&2
      echo "       so enabling/disabling one specific daemon would not do" >&2
      echo "       what it looks like." >&2
      exit 1
    fi
    exec "$SYSTEMCTL" "$cmd" ngps.target
    ;;
  list)
    printf '%s\n' "${DAEMONS[@]}"
    ;;
  *)
    usage
    ;;
esac
