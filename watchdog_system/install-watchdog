#!/bin/bash
#
# install-watchdog -- install the watchdog system from the deploy tree, and
# transition the host away from the legacy ngps-daemon launch mechanism.
#
# Run as root or via sudo.
#

set -e

WATCHDOG_DIR="${WATCHDOG_DIR:-/home/developer/Software/watchdog_system}"
BIN_DIR="${BIN_DIR:-/home/developer/Software/bin}"
RUN_DIR="${RUN_DIR:-/home/developer/Software/run}"

# Sanity: required source files must exist under WATCHDOG_DIR
for f in \
  "$WATCHDOG_DIR/systemd/ngps@.service" \
  "$WATCHDOG_DIR/systemd/ngps.target" \
  "$WATCHDOG_DIR/systemd/ngps-watchdog.service" \
  "$WATCHDOG_DIR/systemd/ngps@sequencerd.service.d/order.conf" \
  "$WATCHDOG_DIR/systemd/ngps.env" \
  "$WATCHDOG_DIR/polkit/10-ngps.rules"; do
  if [ ! -f "$f" ]; then
    echo "ERROR: missing $f -- check out the watchdog branch and rebuild," >&2
    echo "       or set WATCHDOG_DIR to the correct path." >&2
    exit 1
  fi
done

# Verify the built binary that ngps-watchdog.service will exec
if [ ! -x "$BIN_DIR/ngps-watchdog" ]; then
  echo "ERROR: $BIN_DIR/ngps-watchdog not found or not executable." >&2
  echo "       Build the watchdog branch (cmake --build build/) before installing," >&2
  echo "       or set BIN_DIR to the correct path." >&2
  exit 1
fi

# NOTE: on an SELinux-enforcing host, $BIN_DIR's daemon binaries must carry
# an SELinux type systemd is permitted to execute (they default to
# user_home_t under a home directory, which init_t cannot exec -- every
# daemon fails with status=203/EXEC otherwise). This is a one-time, per-host
# manual step, not automated here -- see readme.txt Requirements for the
# exact commands.

# Verify the accounts this script will modify already exist (see readme.txt
# Requirements), and prime the sudo ticket, before touching any system state --
# both failures should be visible immediately, not partway through the install.
if ! id developer >/dev/null 2>&1 || ! id observer >/dev/null 2>&1; then
  echo "ERROR: accounts 'developer' and 'observer' must already exist" >&2
  echo "       (see readme.txt Requirements) before running install-watchdog." >&2
  exit 1
fi
if ! sudo -v; then
  echo "ERROR: this script must be run by a user with sudo privileges." >&2
  exit 1
fi

# Bound sudo calls that have no legitimate reason to take more than a few
# seconds fail loud in 15s instead of hanging forever.
# $1: exit codes to tolerate as non-fatal -- "*" for any (matches a call's
#     pre-existing "|| true" leniency), a colon-separated list for specific
#     idempotent-command codes (e.g. groupadd's "9" = already exists), or
#     "" to tolerate nothing. A 15s timeout (124) is always fatal regardless
#     of $1. $2+: the command.
sudo_bounded() {
  local tolerate=":$1:"; shift
  local rc=0
  timeout -k 5 15 sudo "$@" || rc=$?
  if [ "$rc" -eq 124 ]; then
    echo "ERROR: 'sudo $*' timed out after 15s -- check for a stuck process" >&2
    echo "       or stale lock: ps -ef | grep -E 'usermod|groupadd|passwd'," >&2
    echo "       ls -la /etc/{passwd,group,gshadow}.lock" >&2
    exit 1
  fi
  if [ "$rc" -ne 0 ] && [ "$tolerate" != ":*:" ] && [[ "$tolerate" != *":$rc:"* ]]; then
    exit "$rc"
  fi
  return 0
}

# Take down the legacy launcher so its Restart= behavior does not fight us,
# and remove any live legacy/leftover ngps wrapper (run/ngps, run/_ngps, and
# the older /usr/local/bin/ngps location) so nothing stale can be invoked
# while the watchdog is active.
sudo_bounded "*" systemctl disable --now ngps-daemon.timer
sudo_bounded "*" systemctl disable --now ngps-daemon.service
sudo_bounded ""  rm -f "$RUN_DIR/ngps" "$RUN_DIR/_ngps" /usr/local/bin/ngps

# Install systemd units
sudo_bounded "" install -m 0644 "$WATCHDOG_DIR/systemd/ngps@.service"         /etc/systemd/system/ngps@.service
sudo_bounded "" install -m 0644 "$WATCHDOG_DIR/systemd/ngps.target"           /etc/systemd/system/ngps.target
sudo_bounded "" install -m 0644 "$WATCHDOG_DIR/systemd/ngps-watchdog.service" /etc/systemd/system/ngps-watchdog.service
sudo_bounded "" mkdir -p /etc/systemd/system/ngps@sequencerd.service.d
sudo_bounded "" install -m 0644 "$WATCHDOG_DIR/systemd/ngps@sequencerd.service.d/order.conf" \
                     /etc/systemd/system/ngps@sequencerd.service.d/order.conf

# Install environment file (only on first install -- preserve operator edits)
if [ ! -f /etc/sysconfig/ngps ]; then
  sudo_bounded "" install -m 0644 "$WATCHDOG_DIR/systemd/ngps.env" /etc/sysconfig/ngps
  echo "NOTE: created /etc/sysconfig/ngps -- edit to set PYTHONPATH /"
  echo "      RUBIN_SIM_DATA_DIR / XPA_NSUSERS for this host"
fi

# Install polkit rule and reload polkit so it sees the new rule
sudo_bounded ""  install -m 0644 "$WATCHDOG_DIR/polkit/10-ngps.rules" /etc/polkit-1/rules.d/10-ngps.rules
sudo_bounded "*" systemctl restart polkit

# Create the operator group and add the accounts the watchdog system
# itself depends on for passwordless systemctl access. (Existence of the
# accounts themselves was already verified above.)
sudo_bounded "9" groupadd ngpsops        # 9 = group already exists
sudo_bounded ""  usermod -aG ngpsops developer
sudo_bounded ""  usermod -aG ngpsops observer

# Tell systemd about the new units and start them. --no-block is required,
# not optional: `enable --now` on a target blocks until every unit pulled in
# by its Wants= reaches a terminal state (active or failed), even without any
# After= ordering 
sudo_bounded "" systemctl daemon-reload
sudo_bounded "" systemctl reset-failed
sudo systemctl enable --now --no-block ngps.target
sudo systemctl enable --now --no-block ngps-watchdog.service

# install convenience wrapper for developer only
# other operators use systemctl
sudo_bounded "" chown developer:developer "$WATCHDOG_DIR/bin/ngps"
sudo_bounded "" chmod 744 "$WATCHDOG_DIR/bin/ngps"
sudo_bounded "" install -o developer -g developer -m 700 \
     "$WATCHDOG_DIR/bin/ngps" "$RUN_DIR/ngps"

cat <<'EOF'

Watchdog system installed.

"developer" and "observer" have been added to ngpsops automatically (log
out and back in for the new group membership to take effect). Add any
additional interactive operators the same way:

    sudo usermod -aG ngpsops <username>

Operators control daemons via systemctl directly. A developer-only `ngps`
wrapper is also installed at run/ngps (see readme.txt). Quick reference:

    systemctl start|stop|restart ngps.target              # all 12 daemons
    systemctl start|stop|restart ngps@<name>.service      # one daemon
    systemctl status ngps.target 'ngps@*'                 # status
    systemctl kill ngps.target                            # SIGKILL the lot

This script returns as soon as the daemons' start jobs are queued -- it does
NOT wait for them to actually come up (a daemon that can't reach its hardware
can take up to 60s per unit to fail, and this exit doesn't block on that).
Verify actual daemon health separately:

    systemctl is-enabled ngps.target                                # -> enabled
    ls -l /etc/systemd/system/multi-user.target.wants/ngps.target   # must exist
    systemctl list-units 'ngps@*' --all
    systemctl status ngps.target ngps-watchdog.service

EOF
