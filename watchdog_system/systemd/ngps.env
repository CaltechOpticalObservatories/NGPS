# NGPS daemon environment.
#
# Install to: /etc/sysconfig/ngps
# Referenced by ngps@.service via:  EnvironmentFile=-/etc/sysconfig/ngps
#
# These mirror the Environment= lines from the old ngps-daemon.service. Adjust
# paths to match the deploy target.

PYTHONPATH=/home/developer/Software/Python:/home/developer/.local/lib/python3.9/site-packages:/usr/local/lib64/python3.9/site-packages
RUBIN_SIM_DATA_DIR=/data/rubin_sim/
XPA_NSUSERS=*
