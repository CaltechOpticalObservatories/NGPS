#!/bin/bash

if [[ -z $1 ]]; then
  echo "Usage:  exposen <n> <slitw>"
  echo "  performs <n> exposures at slit width <slitw> (arcsec)"
  echo "  Uses virtual slit method if <slitw> is provided"
  echo ""
  echo "  EXPOSEN_START_TIMEOUT   seconds to wait for camerad to create the file (default 30)"
  echo "  EXPOSEN_READOUT_TIMEOUT seconds beyond exptime to wait for the file to close (default 600, 0=forever)"
  exit
fi

datadir=$(readlink -f "/data/latest")  # replace symlink with real path

# camerad creates the FITS file as soon as the exposure starts, so this can be short
start_timeout=${EXPOSEN_START_TIMEOUT:-30}
# camerad keeps the file open until every channel has written its frame. If a
# frame never arrives the file is never closed, so don't wait forever.
readout_timeout=${EXPOSEN_READOUT_TIMEOUT:-600}

slit_offset_method=false
if [[ $# -gt 1 ]]; then
  slit_offset_method=true
fi

n=$1
slitw=$2

# Print an error, put the slit back if we moved it, and exit non-zero
fail() {
  echo "ERROR: $*" >&2
  if $slit_offset_method; then
    echo "Moving slit to idle position"
    slit set 0.5 -3
  fi
  exit 1
}

# Current exposure time in whole seconds, or 0 if it can't be read
exptime_sec() {
  local ms=`camera exptime`
  ms="${ms%% *}"  # remove "DONE"
  [[ $ms =~ ^[0-9]+$ ]] || ms=0
  echo $(( (ms + 999) / 1000 ))
}

if [ "$slit_offset_method" = true ]; then
  echo "Moving slit to target"
  slit set $slitw 3
fi

# Loop over n exposures
for (( i=1 ; i<=$n ; i++ ));
do
  echo ""
  echo Starting $i of $n
  reply=`camera fitsname`  # next filename
  fitsname="${reply%% *}"  # remove "DONE"
  if [[ "$reply" != *DONE* || "$fitsname" != *.fits ]]; then
    fail "camera fitsname returned: $reply"
  fi

  reply=`camera expose`
  if [[ "$reply" != *DONE* ]]; then
    fail "camera expose returned: $reply"
  fi
  echo Starting exposure...

  # Wait until the file exists
  started=$SECONDS
  while [[ ! -f "$fitsname" ]]; do
    if (( SECONDS - started >= start_timeout )); then
      fail "$fitsname was not created within ${start_timeout}s"
    fi
    sleep 1
  done
  echo Exposing $fitsname

  # Keep checking to see when file is closed. An empty lsof listing means
  # sudo or lsof failed (camerad always has files open), not that the file
  # is closed, so keep waiting in that case.
  started=$SECONDS
  deadline=$(( started + `exptime_sec` + readout_timeout ))
  while true; do
    openfiles=`timeout 10 sudo -n -u dataowner -g datawriters /usr/bin/lsof -w -c camerad`
    if [[ -n "$openfiles" ]] && ! grep -qF "$fitsname" <<< "$openfiles"; then
      break
    fi
    if (( readout_timeout > 0 && SECONDS >= deadline )); then
      # exptime may have been modified during the exposure
      newdeadline=$(( started + `exptime_sec` + readout_timeout ))
      if (( newdeadline <= deadline )); then
        fail "$fitsname still open after $(( SECONDS - started ))s"
      fi
      deadline=$newdeadline
    fi
    sleep 1
  done

  echo "Completed $fitsname"
done

echo "done!"

# Ring system bell a few times (only when run from a terminal)
for (( i=1 ; i<=5 ; i++ ));
do
    [[ -t 1 ]] || break
    printf '\e[?5h'
    sleep 0.1
    tput bel
    printf '\e[?5l'
    sleep 0.1
    tput bel
done

if $slit_offset_method; then
  echo "Moving slit to idle position"
  slit set 0.5 -3
fi
